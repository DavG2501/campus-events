@model CampusEvents.ViewModels.RegisterViewModel

@{
	ViewData["Title"] = "Register";
}

<h1>Create Account</h1>

<p>
	Create a CEMS account. An authenticated account has Participant
	capabilities; no Participant role is required.
</p>

<form asp-controller="Account" asp-action="Register" method="post" asp-antiforgery="true" class="account-form">

	<div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

	<div class="form-field">
		<label asp-for="DisplayName" class="field-label"></label>
		<input asp-for="DisplayName" class="field-control" autocomplete="name" required />
		<span asp-validation-for="DisplayName" class="validation-message"></span>
	</div>

	<div class="form-field">
		<label asp-for="Email" class="field-label"></label>
		<input asp-for="Email" class="field-control" autocomplete="email" required />
		<span asp-validation-for="Email" class="validation-message"></span>
	</div>

	<div class="form-field">
		<label asp-for="Password" class="field-label"></label>
		<input asp-for="Password" class="field-control" autocomplete="new-password" required />
		<span asp-validation-for="Password" class="validation-message"></span>
	</div>

	<div class="form-field">
		<label asp-for="ConfirmPassword" class="field-label"></label>
		<input asp-for="ConfirmPassword" class="field-control" autocomplete="new-password" required />
		<span asp-validation-for="ConfirmPassword" class="validation-message"></span>
	</div>

	<button type="submit" class="button-primary">
		Create account
	</button>
</form>